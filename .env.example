#Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

#Database Configuration
# For development: Use Neon Local PostgreSQL (docker-compose.dev.yml)
#   DB_URL=postgresql://postgres:password@neon-local:5432/postgres
# For production: Use Neon Cloud Database
#   DB_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DB_URL=postgresql://user:password@host:5432/dbname

#Security & Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ARCJET_KEY=ajkey_your_arcjet_site_key
